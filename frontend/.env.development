# GridSense Frontend -- Development Environment
# FastAPI backend URL (must match uvicorn bind address)
VITE_API_URL=http://localhost:8000

# Set to "true" to use local mock data instead of the FastAPI backend
# Useful when working on frontend UI without running the backend
VITE_USE_MOCK=false

# Authentication mode
# "mock"  — use isolated mock auth adapter (no backend required, dev/demo only)
# "api"   — use production API adapter (calls /api/auth/* on the FastAPI backend)
VITE_AUTH_MODE=mock
